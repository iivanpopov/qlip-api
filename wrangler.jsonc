{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qlip-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" },
  },
  "previews": {},
}
